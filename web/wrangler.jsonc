// Cloudflare Workers config: serves the built site (dist/) as static files.
// There is no server code; the security headers come from public/_headers.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "emp-generic-performance",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
